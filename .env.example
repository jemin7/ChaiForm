[TEMPLATE]
# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chaiforms?retryWrites=true&w=majority"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

AUTH_SECRET=""
# AUTH_URL / NEXTAUTH_URL override the origin used for Google OAuth callbacks.
# Leave them unset for local dev (the request origin is used automatically).
# In production, set them to the exact deployed HTTPS URL and register the
# matching /api/auth/callback/google in Google Cloud Console. NEVER leave them
# pointing at http://localhost:3000 in production — Google rejects sign-in with
# Error 400: redirect_uri_mismatch.
# AUTH_URL="https://your-app.example.com"
# NEXTAUTH_URL="https://your-app.example.com"

NEXT_PUBLIC_API_URL="http://localhost:8000"
BASE_URL="http://localhost:8000"
WEB_URL="http://localhost:3000"
PORT="8000"

# AI features (form generation + response insights). OpenAI-compatible API.
# Works with OpenAI, or Google Gemini via its OpenAI-compatible endpoint
# (use your Google AI Studio API key as AI_API_KEY).
AI_API_KEY=""
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
AI_MODEL="gemini-3.7-flash"

# Email notifications on new responses
RESEND_API_KEY=""
EMAIL_FROM="ChaiForm <onboarding@resend.dev>"
